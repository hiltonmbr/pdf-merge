# Caminho da pasta com subpastas de PDFs (obrigatório se não usar --cv-path)
# CV_PATH=/caminho/para/pasta

# Subpasta (relativa a CV_PATH) ou caminho absoluto para salvar o PDF (opcional, padrão: Curriculum Vitae Compilado)
# OUTPUT_DIR=Curriculum Vitae Compilado

# Nome do arquivo PDF final (opcional, padrão: cv_hilton.pdf)
# MERGED_PDF_NAME=cv_hilton.pdf
